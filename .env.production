# Configuration de l'environnement de production

# Configuration DNS et domaine
VITE_PUBLIC_URL=https://signesgabon.ga
VITE_API_BASE_URL=https://api.signesgabon.ga

# Configuration Render et DNS
RENDER_EXTERNAL_URL=https://signesgabon.onrender.com
RENDER_EXTERNAL_HOSTNAME=signesgabon.onrender.com

# Configuration MediaPipe (chemins optimisés pour la production)
VITE_MEDIAPIPE_MODEL_PATH=/models/holistic

# Configuration des assets
VITE_ASSETS_PATH=/assets
VITE_AVATAR_MODEL_PATH=/models/avatar.glb

# Configuration du serveur de production
VITE_PORT=10000
VITE_HOST=0.0.0.0

# Paramètres de performance et sécurité
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_HTTPS=true
VITE_CACHE_CONTROL_MAX_AGE=31536000
VITE_SSL_TYPE=A
VITE_FORCE_SSL=true

# Configuration spécifique à Render
NODE_ENV=production
NPM_CONFIG_PRODUCTION=true